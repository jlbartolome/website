---
import { localUrl } from '../lib/urls';
import { getSite } from '../lib/content';
const site = await getSite();
---
<footer class="institution-footer">
  <a class="institution" href={site.institution.href} aria-label={site.institution.name}>
    <img class="ehu-logo" src={localUrl('assets/ehu-logo.svg')} width="88" height="88" alt={site.institution.logoAlt} />
  </a>
  <div class="footer-contact"><a href={`mailto:${site.email}`}>{site.email} <span aria-hidden="true">↗</span></a></div>
</footer>
