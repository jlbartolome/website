---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  maxWidth?: number;
  sizes?: string;
  priority?: boolean;
  format?: 'webp' | 'png';
}
const { src, alt, caption, maxWidth = 1600, sizes = '(max-width: 760px) calc(100vw - 48px), 800px', priority = false, format = 'webp' } = Astro.props;
const width = Math.min(src.width, maxWidth);
const height = Math.round(src.height * width / src.width);
const widths = [...new Set([320, 640, 960, 1280, width].filter((size) => size <= width))].sort((a, b) => a - b);
---
<figure class="site-image">
  <Image src={src} alt={alt} width={width} height={height} widths={widths} sizes={sizes} format={format} loading={priority ? 'eager' : 'lazy'} decoding="async" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
