---
import { getCollection, render } from 'astro:content';
import ContentSection from '../components/ContentSection.astro';
import ResourceList from '../components/ResourceList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { localUrl } from '../lib/urls';
import { getPage, getSite, byOrder, contentHref } from '../lib/content';
const { data: page } = await getPage('teaching');
const site = await getSite();
const workshops = (await getCollection('workshops', ({ data }) => !data.draft)).sort(byOrder);
const entries = (await getCollection('courses', ({ data }) => !data.draft)).sort(byOrder);
const courses = await Promise.all(entries.map(async (entry) => ({ ...entry, ...(await render(entry)) })));
---
<BaseLayout title={`${page.title} · ${site.name}`} description={page.description}>
<div class="inner-page editorial-page">
<header class="page-intro">
  <h1>{page.title}</h1>
  {page.lead && <p class="lead">{page.lead}</p>}
  <nav class="section-links" aria-label={page.sectionNavLabel}>
    {page.sections.map((section) => <a href={localUrl(`teaching/#${section.id}`)}>{section.title}</a>)}
  </nav>
</header>
{page.sections.map((section) => <ContentSection id={section.id} title={section.title}>
  {section.id === 'courses' && <div class="course-list">{courses.map(({ data, Content }) => <article>
    <h3>{data.title}</h3>
    <div class="prose"><Content /></div>
    {data.links.length > 0 && <div class="resource-links">{data.links.map((link) => <a href={contentHref(link.href)} aria-label={`${link.label}: ${data.title}`}>{link.label} <span aria-hidden="true">↗</span></a>)}</div>}
  </article>)}</div>}
  {section.id === 'schools' && <ResourceList items={workshops} />}
</ContentSection>)}
</div>
</BaseLayout>
