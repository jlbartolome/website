---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Publication from '../components/Publication.astro';
import { getPage, getSite, byOrder } from '../lib/content';
const { data: page } = await getPage('publications');
const site = await getSite();
const entries = (await getCollection('publications', ({ data }) => !data.draft)).sort((a, b) => b.data.year - a.data.year || byOrder(a, b));
const profile = site.profiles.find((item) => item.icon === page.profile);
---
<BaseLayout title={`${page.title} · ${site.name}`} description={page.description}>
  <div class="inner-page">
    <header class="page-intro">
      <h1>{page.title}</h1>
      <nav class="section-links" aria-label={page.sectionNavLabel}>{page.sections.map((section) => <a href={`#${section.id}`}>{section.title}</a>)}{profile && <a href={profile.href}>{profile.name} ↗</a>}</nav>
    </header>
    {page.sections.map((section) => {
      const papers = entries.filter(({ data }) => data.status === section.status);
      const years = [...new Set(papers.map(({ data }) => data.year))];
      return <section class="publication-section" id={section.id} aria-labelledby={`${section.id}-title`}>
        <h2 id={`${section.id}-title`}>{section.title}</h2>
        {years.map((year) => <div class="publication-year"><h3 class="year-label">{year}</h3><div class="papers">{papers.filter(({ data }) => data.year === year).map((entry) => <Publication entry={entry} anchor heading="h4" />)}</div></div>)}
      </section>;
    })}
  </div>
</BaseLayout>
