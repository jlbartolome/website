---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { localUrl } from '../lib/urls';
import { getSite } from '../lib/content';
const site = await getSite();
import '../styles/global.css';

interface Props { title?: string; description?: string; noindex?: boolean; canonicalPath?: string }
const { title = site.title, description = site.description, noindex = false, canonicalPath = Astro.url.pathname } = Astro.props;
const canonical = new URL(canonicalPath, Astro.site);
---
<!doctype html>
<html lang="en" data-design="B1">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFFFFF" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <title>{title}</title>
    <link rel="stylesheet" href={localUrl('fonts/fonts.css')} />
  </head>
  <body>
    <a class="skip" href="#main">{site.skipLabel}</a>
    <div class="page">
      <Header />
      <main id="main"><slot /></main>
      <Footer />
    </div>
  </body>
</html>
